<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>OpaqueByteRegression</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="WolvenKit.CR2W"><HintPath>../bin/WolvenKit.CR2W.dll</HintPath></Reference>
    <Reference Include="WolvenKit.Common"><HintPath>../bin/WolvenKit.Common.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>../bin/Newtonsoft.Json.dll</HintPath></Reference>
    <None Include="../bin/**/*" CopyToOutputDirectory="PreserveNewest" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
